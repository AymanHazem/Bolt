# Copy to .env for local overrides (defaults exist in application-local.yml; required in prod profile)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=bolt
MONGO_USERNAME=change_me
MONGO_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379

APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_DEFAULT_TTL_HOURS=24
APP_ALIAS_LENGTH=6
APP_MAX_ALIAS_RETRIES=10
APP_QR_SIZE=300
APP_QR_MARGIN=1
APP_QR_CACHE_TTL=7
LOG_LEVEL=INFO
